# Artifactory / Nexus secrets — 1Password REFERENCES, not values.
# Safe: contains no secrets, only op:// pointers. Used with `op run`:
#     op run --account salesforce.1password.com --env-file=~/.config/op/artifactory.env -- <cmd>
# (or the `artenv` helper in .zshrc, which targets the work account).
#
# Vault item field IDs may differ from these labels — verify with:
#     op item get artifactory --account salesforce.1password.com
# and adjust the field segment after the last `/` if a reference errors.
#
# NOTE: API_KEY / APIKEY / TOKEN are the SAME secret (verified by hash) — all
# three point at one stored field. AUTH and DEV_APIKEY are distinct values.

# --- Artifactory item (Employee vault) ---
export ARTIFACTORY_USER="op://Employee/artifactory/username"
export ARTIFACTORY_EMAIL="op://Employee/artifactory/email"
export ARTIFACTORY_NPM_URL="op://Employee/artifactory/npm_url"

# Same secret, three names the tooling expects:
export ARTIFACTORY_API_KEY="op://Employee/artifactory/apikey"
export ARTIFACTORY_APIKEY="op://Employee/artifactory/apikey"
export ARTIFACTORY_TOKEN="op://Employee/artifactory/apikey"

# Distinct values:
export ARTIFACTORY_AUTH="op://Employee/artifactory/auth"
export DEV_ARTIFACTORY_APIKEY="op://Employee/artifactory/dev_apikey"

# --- Nexus (store as its own item or fields on artifactory; adjust path) ---
export NEXUS_USERNAME="op://Employee/Nexus/username"
export NEXUS_PASSWORD="op://Employee/Nexus/password"
